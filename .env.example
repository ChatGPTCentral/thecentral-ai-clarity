# Set these in Vercel → Project → Settings → Environment Variables
# (copy to .env.local for local development)

# Microsoft Clarity Data Export API token
# Get it from: https://clarity.microsoft.com → your project → Settings → Data Export → Generate new API token
CLARITY_API_TOKEN=

# Anthropic API key — https://platform.claude.com
ANTHROPIC_API_KEY=

# Any random string. Protects /api/generate; Vercel Cron sends it automatically.
# Generate one with: openssl rand -hex 24
CRON_SECRET=

# BLOB_READ_WRITE_TOKEN is added automatically when you connect a
# Vercel Blob store to the project (Storage tab → Create Blob store).
