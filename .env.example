# Set these in Vercel → Project → Settings → Environment Variables
# (copy to .env.local for local development)
#
# Each data source activates automatically once its variables are present.
# Only Clarity is required; the rest enrich the report as you add them.

# --- Microsoft Clarity (required) — on-page behavior & friction ---
# Clarity → your project → Settings → Data Export → Generate new API token
CLARITY_API_TOKEN=

# --- Anthropic (required) — the AI analyst ---
# https://platform.claude.com
ANTHROPIC_API_KEY=

# --- Report endpoint auth (required) — protects /api/generate ---
# Any random string. Generate with: openssl rand -hex 24
CRON_SECRET=

# --- Google Analytics 4 + Search Console (optional) — traffic, channels,
#     conversion events, and organic search demand ---
# From your Google Cloud service account (JSON key). The service account must be
# granted access to the GA4 property and the Search Console site.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key. In Vercel you can paste the real newlines; if your
# tooling escapes them, \n sequences are also handled.
GOOGLE_PRIVATE_KEY=
# GA4 numeric property ID, e.g. 123456789 (Admin → Property Settings)
GA4_PROPERTY_ID=
# Search Console property, e.g. sc-domain:thecentral.ai  or  https://thecentral.ai/
GSC_SITE_URL=

# --- Vercel Blob (auto-added when you connect a Blob store) ---
# BLOB_STORE_ID is provisioned automatically; no manual entry needed.
